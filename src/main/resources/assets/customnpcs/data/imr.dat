{  "_comment": "Custom Armor Item Model created by default",  "parent": "minecraft:item/generated",  "overrides": [    {      "model": "{mod_id}:item/{file_name}_{slot}_quartz_trim",      "predicate": {        "trim_type": 0.1      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_iron_darker_trim",      "predicate": {        "trim_type": 0.2      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_netherite_trim",      "predicate": {        "trim_type": 0.3      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_redstone_trim",      "predicate": {        "trim_type": 0.4      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_copper_trim",      "predicate": {        "trim_type": 0.5      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_gold_trim",      "predicate": {        "trim_type": 0.6      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_emerald_trim",      "predicate": {        "trim_type": 0.7      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_diamond_trim",      "predicate": {        "trim_type": 0.8      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_lapis_trim",      "predicate": {        "trim_type": 0.9      }    },    {      "model": "{mod_id}:item/{file_name}_{slot}_amethyst_trim",      "predicate": {        "trim_type": 1.0      }    }  ],  "textures": {    "layer0": "{mod_id}:item/{name}_{slot}"  }}