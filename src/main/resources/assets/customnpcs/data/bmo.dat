{  "_comment": "Custom Block OBJ Model created by default",  "loader": "forge:obj",  "flip_v": true,  "model": "{mod_id}:models/block/obj/{file_name}.obj",  "textures": {    "body": "{mod_id}:block/{name}",    "top": "{mod_id}:block/{name}_top"  },  "display": {    "firstperson_righthand": {      "translation": [3, 1, 0],      "scale": [ 0.5, 0.5, 0.5 ]    },    "firstperson_lefthand": {      "translation": [3, 1, 0],      "scale": [ 0.5, 0.5, 0.5 ]    },    "thirdperson_righthand": {      "translation": [0, 2, 1],      "scale": [ 0.375, 0.375, 0.375 ]    },    "thirdperson_lefthand": {      "translation": [0, 2, 1],      "scale": [ 0.375, 0.375, 0.375 ]    },    "gui": {      "rotation": [ 45, 45, 0 ],      "scale": [ 0.65, 0.65, 0.65 ]    },    "ground": {      "translation": [0, 2, 0],      "scale": [ 0.5, 0.5, 0.5 ]    },    "head": {      "rotation": [ -90, 180, 0 ],      "translation": [0, 0.3125, 0],      "scale": [ 1.5, 1.5, 1.5 ]    },    "fixed": {      "rotation": [ 0, 90, 0 ],      "scale": [ 0.5, 0.5, 0.5 ]    }  }}