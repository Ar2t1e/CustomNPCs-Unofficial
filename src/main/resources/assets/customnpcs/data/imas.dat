{  "loader": "forge:obj",  "flip_v": true,  "model": "{mod_id}:models/item/obj/{name}.obj",  "textures": {    "top": "{mod_id}:item/{name}"  },  "display": {    "firstperson_righthand": {      "translation": [3, 1, 0]    },    "firstperson_lefthand": {      "translation": [3, 1, 0]    },    "thirdperson_righthand": {      "translation": [0, 2, 1]    },    "thirdperson_lefthand": {      "translation": [0, 2, 1]    },    "gui": {      "rotation": [ 90, 45, -90 ],      "translation": [0, -1, 0]    },    "ground": {      "rotation": [ 45, 0, 0 ],      "scale": [ 0.75, 0.75, 0.75 ]    },    "head": {      "rotation": [ 60, 195, -30 ],      "translation": [0.0625, 0.4375, -0.6875],      "scale": [ 1.5, 1.5, 1.5 ]    },    "fixed": {      "rotation": [ 0, 90, 0 ],      "translation": [0, 0.5, 0]    }  }}